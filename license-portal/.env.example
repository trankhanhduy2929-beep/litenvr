# Phiên đăng nhập (cookie ký HMAC). Bỏ trống AUTH_SECRET sẽ dùng LICENSE_SIGNING_SECRET.
AUTH_SECRET=change-me-session-secret
# Bí mật ký token license (tối thiểu 32 ký tự ngẫu nhiên)
LICENSE_SIGNING_SECRET=change-me-to-a-long-random-secret
# Token API quản trị cũ; /admin dùng tài khoản role=admin, token chỉ để gọi API.
ADMIN_TOKEN=change-me-admin-token

# D1 qua Cloudflare Worker gateway (khuyến nghị)
DATABASE_PROVIDER=d1
D1_GATEWAY_URL=https://litenvr-license-db.example.workers.dev/batch
D1_GATEWAY_SECRET=change-me-gateway-secret

# MySQL dự phòng: đặt DATABASE_PROVIDER=mysql và điền DB_*
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=3306
# DB_USER=avnadmin
# DB_PASSWORD=change-me
# DB_NAME=litenvr
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true

# Giá bán (VND) - hiển thị công khai
NEXT_PUBLIC_PRICE_WEEKLY=50000
NEXT_PUBLIC_PRICE_LIFETIME=200000

# PayOS (tùy chọn). Bỏ trống để chỉ dùng chuyển khoản thủ công.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://your-domain.vercel.app/success
PAYOS_CANCEL_URL=https://your-domain.vercel.app/?canceled=1

# Thông tin chuyển khoản thủ công (hiển thị trên trang mua)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT=
NEXT_PUBLIC_BANK_OWNER=
NEXT_PUBLIC_SUPPORT_CONTACT=

# URL LiteNVR addon/repo để hiển thị trên trang chủ
NEXT_PUBLIC_LITENVR_URL=https://github.com/your-org/litenvr
